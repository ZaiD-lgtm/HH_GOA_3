# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- reverse image search (at least one) ---------------------------------
# SerpAPI Google Lens - https://serpapi.com  (free tier: 100 searches/month)
SERPAPI_KEY=

# Azure Bing Visual Search - accepts a direct upload, no image host needed
BING_VISUAL_SEARCH_KEY=
BING_VISUAL_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/visualsearch

# Optional: public host for the probe crop (default is keyless catbox.moe)
IMGBB_KEY=

# --- blockchain ----------------------------------------------------------
# Leave blank to use the built-in local chain (CHAIN=local).
RPC_URL=
PRIVATE_KEY=
CHAIN_NAME=sepolia
EXPLORER_BASE=https://sepolia.etherscan.io/tx/
EVM_MODE=calldata
CONTRACT_ADDRESS=
