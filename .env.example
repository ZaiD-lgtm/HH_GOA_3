# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- reverse image search (at least one) ---------------------------------
# SerpAPI Google Lens - https://serpapi.com/manage-api-key
# Free plan: 250 searches/month. The key is 64 hex characters; if you copied a
# "serp" prefix along with it the API returns 401 Invalid API key.
SERPAPI_KEY=

# Google Cloud Vision Web Detection - https://console.cloud.google.com/apis/credentials
# Free for the first 1,000 units/month, then $3.50/1,000. Needs a GCP project
# with billing enabled and the Cloud Vision API turned on. Unlike SerpAPI this
# takes the image as a direct upload, so the probe crop is never published.
GOOGLE_VISION_API_KEY=

# Optional: public host for the probe crop, used by the SerpAPI and Yandex
# providers only. Defaults to keyless catbox.moe.
IMGBB_KEY=

# NOTE: Bing Visual Search is not an option - Microsoft retired the entire Bing
# Search API family on 2025-08-11, with no new signups and 410 on old keys.

# --- blockchain ----------------------------------------------------------
# Leave blank to use the built-in local chain (--chain local, the default).
RPC_URL=
PRIVATE_KEY=
CHAIN_NAME=sepolia
EXPLORER_BASE=https://sepolia.etherscan.io/tx/
EVM_MODE=calldata
CONTRACT_ADDRESS=
